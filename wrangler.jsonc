{
  "name": "court-rollcall",
  "main": "server/index.ts",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "court-rollcall",
      "database_id": "5bd171d7-85d2-41ab-96bc-e5f8e3b79164",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": false
  },
  "account_id": "c597f355328ca480dcd278935391fc28"
}